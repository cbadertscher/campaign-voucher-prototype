# CampaignVoucher M5 cost-estimate parameters (SPEC §7: "parameters captured at
# estimation time"). Copy this file to .env and edit before running
# `forge script script/CostEstimate.s.sol` or `script/ProgramCost.s.sol`.
#
# Defaults below are calibrated from actual research as of 2026-08-04, not
# illustrative round numbers -- but both figures drift daily, so re-check them
# before relying on the report for anything real.

# Which L1 price scenario this run measures: low | normal | high. Ignored (and
# unnecessary) when running with --fork-url, which auto-selects the Base
# scenario instead and reads the live basefee/GasPriceOracle rather than a
# pinned value. Each scenario gets its own vm.fee(...)-pinned measurement, not
# a shared one -- see CostEstimate.s.sol's own doc comment for why.
L1_SCENARIO=normal

# USD per 1 ETH. ~$1,832-1,875 as of 2026-08-03/04 (Metamask, Yahoo Finance,
# Fortune all converge on this range intraday).
ETH_USD=1850

# L1 (Ethereum mainnet) gas price scenarios, in milli-gwei (1000 = 1 gwei).
# Milli-gwei, not gwei, because real 2026 L1 gas is sub-1-gwei -- plain-gwei
# integers would round "low"/"normal" down to zero. This is a structural shift,
# not noise: the Dencun (Mar 2024), Pectra (May 2025) and Fusaka (Dec 2025)
# upgrades moved rollup data off the execution gas market and raised the L1 gas
# limit 30M->60M, so mainnet is no longer priced like a permanently congested
# chain (see ethereum.org/latest/building-on-ethereum-in-2026).
#
# Levels reflect the past ~6 months (roughly Feb-Aug 2026):
#   low    ~0.1 gwei -- quiet-period spot readings (Milkroad, Etherscan).
#   normal ~0.5 gwei -- matches the ~0.45-0.58 gwei median/current reading
#                       (YCharts) and ethereum.org's own April 2026 daily average.
#   high   ~8 gwei   -- matches the largest observed spike in the period
#                       (Etherscan, ~8.8 gwei on 2026-06-05).
L1_GAS_PRICE_LOW_MGWEI=100
L1_GAS_PRICE_NORMAL_MGWEI=500
L1_GAS_PRICE_HIGH_MGWEI=8000
